{
  "name": "ai-photovault",
  "private": true,
  "version": "1.0.0-rc.1",
  "type": "module",
  "description": "Open-source, self-hosted AI photo library: semantic search, AI curation, metadata indexing. Private by default.",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "app/shared",
    "app/server",
    "app/web"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "npm run dev -w @photovault/server",
    "dev:web": "npm run dev -w @photovault/web",
    "build": "npm run build -w @photovault/shared && npm run build -w @photovault/server && npm run build -w @photovault/web",
    "lint": "eslint .",
    "typecheck": "tsc -b app/shared app/server && npm run typecheck -w @photovault/web",
    "test": "vitest run --project node --project web",
    "test:db": "vitest run --project db",
    "test:all": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "setup:env": "node scripts/setup-env.mjs",
    "db:migrate": "npm run migrate:up -w @photovault/server",
    "db:rollback": "npm run migrate:down -w @photovault/server",
    "start": "npm run start -w @photovault/server",
    "worker": "npm run worker -w @photovault/server --",
    "user": "npm run user -w @photovault/server --",
    "ingest": "npm run ingest -w @photovault/server --",
    "ingest:approve": "npm run ingest:approve -w @photovault/server --",
    "storage:init": "npm run storage:init -w @photovault/server --",
    "demo:photos": "npm run demo:photos -w @photovault/server --",
    "seed:demo": "npm run seed:demo -w @photovault/server --",
    "ops": "npm run ops -w @photovault/server --",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "validate": "node scripts/validate-install.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "jsdom": "^31.0.0",
    "npm-run-all2": "^9.0.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0"
  },
  "license": "MIT"
}
