{
  "name": "@photovault/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -b",
    "migrate:up": "tsx src/db/migrate.ts up",
    "migrate:down": "tsx src/db/migrate.ts down",
    "user": "tsx src/cli/user.ts",
    "ingest": "tsx src/cli/ingest.ts",
    "ingest:approve": "tsx src/cli/ingest.ts approve",
    "worker": "tsx src/cli/worker.ts",
    "demo:photos": "tsx src/cli/make-demo-photos.ts",
    "ops": "tsx src/cli/ops.ts",
    "seed:demo": "tsx src/cli/seed-demo.ts",
    "storage:init": "tsx src/cli/storage-init.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.5",
    "@photovault/shared": "*",
    "@node-rs/argon2": "^2.2.2",
    "exifr": "^7.1.3",
    "fastify": "^5.0.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pino": "^9.0.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6"
  }
}
