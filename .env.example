# AI PhotoVault configuration. Copy to .env (or run `npm run setup:env`, which fills in random secrets for you).
# NEVER commit .env. Every value below is a placeholder.

# ---- where things are -------------------------------------------------------------------------------------------------
# Your photo folder, mounted READ-ONLY into the container. Use an absolute path (Windows: C:/Users/you/Pictures/Exports).
PHOTOVAULT_PHOTOS_DIR=./photos
# Port on this computer (127.0.0.1 only).
PHOTOVAULT_PORT=8480
# Display name of the import source in the app.
PHOTOVAULT_INGEST_NAME=My photos
# How often the worker rescans the folder for new photos, in minutes (0 = never; the minimum is 15).
PHOTOVAULT_SCAN_INTERVAL_MIN=360

# ---- database (generated by the setup script) -------------------------------------------------------------------------
PHOTOVAULT_DB=photovault
POSTGRES_PASSWORD=__GENERATED__
PHOTOVAULT_DB_OWNER_PASSWORD=__GENERATED__
PHOTOVAULT_DB_APP_PASSWORD=__GENERATED__
PHOTOVAULT_DB_SERVICE_PASSWORD=__GENERATED__
PHOTOVAULT_DB_DELIVERY_PASSWORD=__GENERATED__
PHOTOVAULT_DB_BACKUP_PASSWORD=__GENERATED__

# ---- application secrets (generated: 64 hex characters each) ----------------------------------------------------------
PHOTOVAULT_SESSION_SECRET=__GENERATED_HEX__
PHOTOVAULT_TOKEN_ENC_KEY=__GENERATED_HEX__

# ---- AI (all optional; off or local by default) -----------------------------------------------------------------------
# Local AI through Ollama. With `docker compose --profile ollama up -d` the compose service named "ollama" is used.
# Photographs are only ever sent to loopback, or to a host YOU list in PHOTOVAULT_OLLAMA_ALLOWED_HOSTS.
PHOTOVAULT_OLLAMA_URL=http://ollama:11434
PHOTOVAULT_OLLAMA_ALLOWED_HOSTS=ollama
PHOTOVAULT_OLLAMA_VISION_MODEL=gemma3:4b
PHOTOVAULT_OLLAMA_EMBED_MODEL=nomic-embed-text
# Place-name lookup (typed place text is sent to OpenStreetMap Nominatim). OFF unless you set "on".
PHOTOVAULT_GEOCODER=off

# ---- optional Instagram / Meta integration (leave empty to keep it off) ----------------------------------------------
# PHOTOVAULT_IG_APP_ID=
# PHOTOVAULT_IG_APP_SECRET=
# PHOTOVAULT_IG_REDIRECT_URI=https://your-own-https-address.example/api/instagram/oauth/callback
# PHOTOVAULT_IG_LIVE=approved

# ---- demo -------------------------------------------------------------------------------------------------------------
PHOTOVAULT_DEMO_MODE=0
